+REXCVAR_DEFINE_BOOL(vr_dlss, false, "VR", "DLSS in VR (needs bbport_dlss.dll and nvngx_dlss.dll beside the program)");
+REXCVAR_DEFINE_DOUBLE(vr_dlss_output_scale, 1.0, "VR",
