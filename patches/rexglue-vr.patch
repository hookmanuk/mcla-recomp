+    return;
+  }
+  real.vkCmdBeginQuery(cb, Find(query_pool_twins, pool), query, flags);
+}
+
+void VKAPI_PTR RightEndQuery(VkCommandBuffer cb, VkQueryPool pool, uint32_t query) {
+  if (Multiview()) {
+    return;
