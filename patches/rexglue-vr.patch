+        key.dimension == xenos::DataDimension::k2DOrStacked && key.GetDepthOrArraySize() == 1 &&
+        ((key.GetWidth() + 31) & ~31u) == width_aligned && ((key.GetHeight() + 31) & ~31u) == height_aligned) {
+      return texture.get();
+    }
+  }
